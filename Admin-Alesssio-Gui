local function playTroll(index)
	if index < 1 or index > 100 then return end
	if activeTrollCleanup then
		if activeTrollIndex == index then stopTroll(); notify("Effekt beendet."); return end
		stopTroll()
	end
	if not refreshCharacter() then notify("Warte, bis dein Charakter erscheint.", true); return end
	local name = trollNames[index]
	local family = math.floor((index - 1) / 20) + 1
	local variant = (index - 1) % 20 + 1
	local duration = 4.2
	local color = Color3.fromHSV(((index * 0.071) + 0.04) % 1, 0.78, 1)
	local cleaned = false
	local cleanupList = {}
	local function cleanup()
		if cleaned then return end
		cleaned = true
		for _, item in ipairs(cleanupList) do
			if typeof(item) == "RBXScriptConnection" then item:Disconnect()
			elseif typeof(item) == "Instance" and item.Parent then item:Destroy()
			elseif type(item) == "function" then pcall(item) end
		end
		if activeTrollCleanup == cleanup then activeTrollCleanup = nil; activeTrollIndex = nil end
	end
	activeTrollCleanup = cleanup
	activeTrollIndex = index

	if family == 1 then
		local h = make("Highlight", character, {
			Name = "AlessioLocalTrollGlow",
			FillColor = color,
			OutlineColor = Color3.fromHSV((index * 0.113) % 1, 0.55, 1),
			FillTransparency = 0.25 + (variant % 5) * 0.08,
			OutlineTransparency = 0.05,
			DepthMode = variant % 2 == 0 and Enum.HighlightDepthMode.Occluded or Enum.HighlightDepthMode.AlwaysOnTop,
		})
		table.insert(cleanupList, h)
		local connection = RunService.Heartbeat:Connect(function()
			if h.Parent then h.FillTransparency = 0.2 + (math.sin(os.clock() * (1.3 + variant * 0.17)) + 1) * 0.19 end
		end)
		table.insert(cleanupList, connection)
	elseif family == 2 then
		local pieces = {}
		local count = 3 + (variant % 6)
		for i = 1, count do
			local part = make("Part", Workspace, {
				Name = "AlessioOrbitLocal",
				Shape = (i + variant) % 3 == 0 and Enum.PartType.Block or Enum.PartType.Ball,
				Size = Vector3.new(0.22 + (variant % 4) * 0.07, 0.22 + (variant % 4) * 0.07, 0.22 + (variant % 4) * 0.07),
				Material = Enum.Material.Neon,
				Color = Color3.fromHSV((index * 0.071 + i * 0.09) % 1, 0.8, 1),
				Anchored = true,
				CanCollide = false,
				CanTouch = false,
				CanQuery = false,
				CastShadow = false,
			})
			pieces[i] = part
			table.insert(cleanupList, part)
		end
		local connection = RunService.RenderStepped:Connect(function()
			if not root or not root.Parent then return end
			local now = os.clock()
			local rate = (0.55 + variant * 0.095) * (variant % 2 == 0 and -1 or 1)
			for i, part in ipairs(pieces) do
				local angle = now * rate + (i - 1) * math.pi * 2 / count
				local rx = 1.5 + variant * 0.035
				local rz = rx * (0.65 + (variant % 5) * 0.12)
				local y = math.sin(angle * (0.65 + variant * 0.01)) * (0.5 + (i % 3) * 0.2)
				part.CFrame = CFrame.new(root.Position + Vector3.new(math.cos(angle) * rx, y, math.sin(angle) * rz)) * CFrame.Angles(angle, angle * 0.6, angle * 0.3)
			end
		end)
		table.insert(cleanupList, connection)
	elseif family == 3 then
		local overlay = make("Frame", screen, {
			Name = "AlessioLocalScreenGag",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ZIndex = 12,
			Active = false,
		})
		table.insert(cleanupList, overlay)
		local pieces = {}
		local count = 9 + (variant % 8)
		for i = 1, count do
			local piece = make("Frame", overlay, {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(random:NextNumber(), random:NextNumber()),
				Size = UDim2.fromOffset(5 + (i + variant) % 14, 5 + (i * variant) % 12),
				BackgroundColor3 = Color3.fromHSV((index * 0.071 + i / count) % 1, 0.75, 1),
				BackgroundTransparency = 0.08,
				Rotation = (i * 43 + variant * 11) % 360,
				BorderSizePixel = 0,
				ZIndex = 13,
			})
			corner(piece, (i + variant) % 2 == 0 and 8 or 2)
			pieces[i] = piece
		end
		for i, piece in ipairs(pieces) do
			local durationThis = 1.3 + (i % 5) * 0.22 + variant * 0.025
			local x = ((i * 0.127 + variant * 0.037) % 1)
			local y = ((i * 0.193 + variant * 0.061) % 1)
			tween(piece, durationThis, {
				Position = UDim2.fromScale(x, y),
				Rotation = piece.Rotation + 180 + variant * 9,
				BackgroundTransparency = 0.12 + (i % 4) * 0.12,
			}, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
		end
	elseif family == 4 then
		local cam = Workspace.CurrentCamera
		local oldFov = cam and cam.FieldOfView
		local oldOffset = humanoid.CameraOffset
		local connection = RunService.RenderStepped:Connect(function()
			if not humanoid or not humanoid.Parent then return end
			local t = os.clock() * (0.7 + variant * 0.12)
			local amp = 0.025 + variant * 0.002
			local x, y = math.sin(t) * amp, math.cos(t * (0.72 + variant * 0.01)) * amp
			if variant % 4 == 1 then humanoid.CameraOffset = oldOffset + Vector3.new(x * 4, 0, 0)
			elseif variant % 4 == 2 then humanoid.CameraOffset = oldOffset + Vector3.new(0, y * 4, 0)
			elseif variant % 4 == 3 then humanoid.CameraOffset = oldOffset + Vector3.new(x * 3, y * 3, 0)
			else humanoid.CameraOffset = oldOffset end
			if cam and cam.Parent then cam.FieldOfView = math.clamp(oldFov + math.sin(t * 1.4) * (1.3 + variant * 0.11), 20, 120) end
		end)
		table.insert(cleanupList, connection)
		table.insert(cleanupList, function()
			if humanoid and humanoid.Parent then humanoid.CameraOffset = oldOffset end
			if cam and cam.Parent and oldFov then tween(cam, 0.25, { FieldOfView = oldFov }) end
		end)
	else
		local motors = {}
		for _, item in ipairs(character:GetDescendants()) do
			if item:IsA("Motor6D") and item.Name ~= "RootJoint" and item.Name ~= "Root" then
				motors[#motors + 1] = { Motor = item, Original = item.Transform }
			end
		end
		local connection = RunService.PreSimulation:Connect(function()
			local t = os.clock() * (1.5 + variant * 0.08)
			for i, data in ipairs(motors) do
				if data.Motor.Parent then
					local sign = ((i + variant) % 2 == 0) and 1 or -1
					local amount = math.sin(t + i * 0.8) * math.rad(5 + variant * 0.45) * sign
					local axis = (variant + i) % 3
					local rotation = axis == 0 and CFrame.Angles(amount, 0, 0) or (axis == 1 and CFrame.Angles(0, amount, 0) or CFrame.Angles(0, 0, amount))
					data.Motor.Transform = data.Original * rotation
				end
			end
		end)
		table.insert(cleanupList, connection)
		table.insert(cleanupList, function()
			for _, data in ipairs(motors) do if data.Motor.Parent then data.Motor.Transform = data.Original end end
		end)
	end

	notify(name .. " · nur für dich · erneut klicken zum Beenden")
	task.delay(duration, cleanup)
end

