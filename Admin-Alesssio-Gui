local function spectateStep(direction)
	local list = eligibleSpectatePlayers()
	if #list == 0 then notify("Gerade ist niemand anderes im Server.", true); return end
	spectateIndex = ((spectateIndex - 1 + direction) % #list) + 1
	local target = list[spectateIndex]
	local camera = Workspace.CurrentCamera
	local targetHumanoid = target.Character and target.Character:FindFirstChildOfClass("Humanoid")
	if camera and targetHumanoid then
		camera.CameraSubject = targetHumanoid
		notify("Spectate: " .. target.DisplayName)
	end
end

