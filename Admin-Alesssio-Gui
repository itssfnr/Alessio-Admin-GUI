local function getSafeLanding(savedCFrame)
	if not refreshCharacter() then return nil, "Charakter fehlt" end
	local p = savedCFrame.Position
	if math.abs(p.X) > 100000 or math.abs(p.Y) > 100000 or math.abs(p.Z) > 100000 then return nil, "Ziel liegt außerhalb des erlaubten Bereichs" end
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { character }
	rayParams.IgnoreWater = true
	local hit = Workspace:Raycast(p + Vector3.new(0, 45, 0), Vector3.new(0, -100, 0), rayParams)
	if not hit or hit.Position.Y > p.Y + 8 or hit.Position.Y < p.Y - 40 then return nil, "Kein sicherer Boden am gespeicherten Ort" end
	local y = hit.Position.Y + humanoid.HipHeight + root.Size.Y * 0.5 + 0.35
	local destination = Vector3.new(p.X, y, p.Z)
	local overlap = OverlapParams.new()
	overlap.FilterType = Enum.RaycastFilterType.Exclude
	overlap.FilterDescendantsInstances = { character }
	local parts = Workspace:GetPartBoundsInBox(CFrame.new(destination), Vector3.new(2.5, 4, 2.5), overlap)
	for _, part in ipairs(parts) do
		if part.CanCollide and part.Transparency < 1 then return nil, "Der Zielpunkt ist blockiert" end
	end
	return CFrame.new(destination) * savedCFrame.Rotation
end

local function teleportTo(savedCFrame, successText)
	local safe, reason = getSafeLanding(savedCFrame)
	if not safe then notify(reason, true); return end
	local glow = make("Highlight", character, {
		Name = "AlessioTeleportFlash",
		FillColor = T.accent2,
		OutlineColor = T.text,
		FillTransparency = 0.15,
		OutlineTransparency = 0.05,
		DepthMode = Enum.HighlightDepthMode.AlwaysOnTop,
	})
	root.AssemblyLinearVelocity = Vector3.zero
	character:PivotTo(safe)
	tween(glow, 0.28, { FillTransparency = 1, OutlineTransparency = 1 })
	task.delay(0.32, function() if glow.Parent then glow:Destroy() end end)
	notify(successText)
end

local auraEnabled, auraStrength, auraStyle = false, 1, 1
local auraParts, auraConnection = {}, nil
local function clearAura()
	auraEnabled = false
	if auraConnection then auraConnection:Disconnect(); auraConnection = nil end
	for _, item in ipairs(auraParts) do if item and item.Parent then item:Destroy() end end
	auraParts = {}
end

local function buildAura()
	clearAura()
	if not refreshCharacter() then notify("Warte, bis dein Charakter erscheint.", true); return end
	auraEnabled = true
	local color = Color3.fromHSV((auraStyle * 0.137) % 1, 0.8, 1)
	local count = 7
	for i = 1, count do
		local part = make("Part", Workspace, {
			Name = "AlessioAuraLocal",
			Shape = i == 1 and Enum.PartType.Cylinder or ((auraStyle % 3 == 0 and i % 2 == 0) and Enum.PartType.Block or Enum.PartType.Ball),
			Size = i == 1 and Vector3.new(0.12, 4.3, 4.3) or Vector3.new(0.3, 0.3, 0.3),
			Material = Enum.Material.Neon,
			Color = color,
			Transparency = 0.18,
			Anchored = true,
			CanCollide = false,
			CanTouch = false,
			CanQuery = false,
			CastShadow = false,
		})
		auraParts[i] = part
	end
	auraConnection = RunService.Heartbeat:Connect(function()
		if not auraEnabled or not refreshCharacter() then clearAura(); return end
		local now = os.clock()
		local radius = 2.0 + auraStrength * 0.55
		local hue = (auraStyle * 0.137 + now * 0.08) % 1
		local currentColor = Color3.fromHSV(hue, 0.82, 1)
		for i, part in ipairs(auraParts) do
			if part and part.Parent then
				part.Color = currentColor
				if i == 1 then
					part.Size = Vector3.new(0.12, radius * 2, radius * 2)
					part.CFrame = CFrame.new(root.Position + Vector3.new(0, -humanoid.HipHeight + 0.5, 0)) * CFrame.Angles(0, 0, math.rad(90))
				else
					local angle = now * (0.75 + auraStrength * 0.18) + (i - 2) * (math.pi * 2 / (count - 1))
					local y = math.sin(now * 1.6 + i) * (0.65 + auraStrength * 0.12)
					local offset = Vector3.new(math.cos(angle) * radius, y, math.sin(angle) * radius)
					part.CFrame = CFrame.new(root.Position + offset)
				end
			end
		end
	end)
end

local flyEnabled, flySpeed, flyVertical = false, 48, 0
local flyAttachment, flyVelocity, flyConnection
local flyHumanoid, flyRoot, flyCameraOffset, savedAutoRotate
local function setFly(on)
	if on == flyEnabled then return end
	if on then
		if not refreshCharacter() then notify("Warte, bis dein Charakter erscheint.", true); return end
		flyEnabled = true
		flyHumanoid, flyRoot = humanoid, root
		savedAutoRotate = humanoid.AutoRotate
		flyCameraOffset = humanoid.CameraOffset
		tween(humanoid, 0.18, { CameraOffset = flyCameraOffset + Vector3.new(0, 0.22, 0) })
		humanoid.AutoRotate = false
		humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		flyAttachment = make("Attachment", flyRoot, { Name = "AlessioFlyAttachment" })
		flyVelocity = make("LinearVelocity", flyRoot, {
			Name = "AlessioFlyVelocity",
			Attachment0 = flyAttachment,
			RelativeTo = Enum.ActuatorRelativeTo.World,
			VelocityConstraintMode = Enum.VelocityConstraintMode.Vector,
			VectorVelocity = Vector3.zero,
			MaxForce = 100000,
		})
		flyControls.Visible = true
		flyConnection = RunService.Heartbeat:Connect(function()
			if not flyEnabled or not flyHumanoid or not flyHumanoid.Parent or not flyRoot or not flyRoot.Parent or not flyVelocity or not flyVelocity.Parent then return end
			local move = flyHumanoid.MoveDirection
			local vertical = flyVertical
			if UserInputService:IsKeyDown(Enum.KeyCode.Space) then vertical = 1 end
			if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.RightControl) then vertical = -1 end
			if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR2) then vertical = 1 end
			if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL2) then vertical = -1 end
			local camera = Workspace.CurrentCamera
			if camera and move.Magnitude > 0.01 then
				local look = camera.CFrame.LookVector
				local right = camera.CFrame.RightVector
				local flatForward = Vector3.new(look.X, 0, look.Z)
				if flatForward.Magnitude > 0.01 then
					flatForward = flatForward.Unit
					local flatRight = Vector3.new(right.X, 0, right.Z).Unit
					move = flatRight * move:Dot(flatRight) + flatForward * move:Dot(flatForward)
				end
			end
			flyVelocity.VectorVelocity = move * flySpeed + Vector3.new(0, vertical * flySpeed, 0)
		end)
		notify("Fly aktiviert · WASD/Joystick, Space hoch, Ctrl runter")
	else
		flyEnabled = false
		flyVertical = 0
		if flyConnection then flyConnection:Disconnect(); flyConnection = nil end
		if flyVelocity then flyVelocity:Destroy(); flyVelocity = nil end
		if flyAttachment then flyAttachment:Destroy(); flyAttachment = nil end
		flyControls.Visible = false
		if flyHumanoid and flyHumanoid.Parent then
			flyHumanoid.AutoRotate = savedAutoRotate ~= nil and savedAutoRotate or (defaultAutoRotate ~= nil and defaultAutoRotate or true)
			tween(flyHumanoid, 0.18, { CameraOffset = flyCameraOffset or defaultCameraOffset })
			flyHumanoid:ChangeState(Enum.HumanoidStateType.Running)
		end
		flyHumanoid, flyRoot, flyCameraOffset, savedAutoRotate = nil, nil, nil, nil
		notify("Fly beendet · Bewegung wieder normal")
	end
end

