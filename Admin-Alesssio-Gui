local function windowBounds()
	local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
	return math.min(680, math.max(320, viewport.X - 24)), math.min(1120, math.max(360, viewport.X - 20)),
		math.min(440, math.max(280, viewport.Y - 48)), math.min(780, math.max(300, viewport.Y - 40))
end
local function changeWindowSize(widthDelta, heightDelta)
	local minWidth, maxWidth, minHeight, maxHeight = windowBounds()
	local width = math.clamp(main.Size.X.Offset + widthDelta, minWidth, maxWidth)
	local height = math.clamp(main.Size.Y.Offset + heightDelta, minHeight, maxHeight)
	tween(main, 0.2, { Size = UDim2.fromOffset(width, height) })
end
addCore(10, "Fenstergröße zurücksetzen", "Stellt die Standardgröße des Panels ein.", function()
	local minWidth, maxWidth, minHeight, maxHeight = windowBounds()
	tween(main, 0.25, { Size = UDim2.fromOffset(math.clamp(920, minWidth, maxWidth), math.clamp(640, minHeight, maxHeight)) })
end)
addCore(10, "Fenster kleiner", "Verkleinert das Panel.", function() changeWindowSize(-70, -45) end)
addCore(10, "Fenster größer", "Vergrößert das Panel.", function() changeWindowSize(70, 45) end)
