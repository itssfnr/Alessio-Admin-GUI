-- F2: toggle the panel, ignoring keystrokes while the player is typing.
local opening = false
togglePanel = function()
	if opening then return end
	opening = true
	if main.Visible then
		local closeTween = tween(main, 0.18, { GroupTransparency = 1 })
		if closeTween then closeTween.Completed:Once(function() main.Visible = false; opening = false end) else main.Visible = false; opening = false end
	else
		main.Visible = true
		main.GroupTransparency = 1
		local openTween = tween(main, 0.23, { GroupTransparency = 0 })
		if openTween then openTween.Completed:Once(function() opening = false end) else opening = false end
	end
end
closeButton.Activated:Connect(togglePanel)
UserInputService.InputBegan:Connect(function(input, processed)
	if input.KeyCode == Enum.KeyCode.F2 and not UserInputService:GetFocusedTextBox() then
		togglePanel()
	elseif flyEnabled and input.KeyCode == Enum.KeyCode.Space then flyVertical = 1
	elseif flyEnabled and (input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl) then flyVertical = -1 end
end)
UserInputService.InputEnded:Connect(function(input)
	if flyEnabled and (input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.LeftControl or input.KeyCode == Enum.KeyCode.RightControl) then flyVertical = 0 end
end)

-- Dragging the title bar and resizing the bottom-right grip work with mouse and touch.
local dragging, resizing = false, false
local dragInput, dragStart, startPosition
local resizeInput, resizeStart, startSize
header.Active = true
title.Active = true
subtitle.Active = true
local function startDragging(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPosition = main.Position
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then dragging = false end end)
	end
end
header.InputBegan:Connect(startDragging)
title.InputBegan:Connect(startDragging)
subtitle.InputBegan:Connect(startDragging)
header.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then dragInput = input end
end)

local grip = make("TextButton", main, {
	Name = "ResizeGrip",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -4, 1, -4),
	Size = UDim2.fromOffset(28, 28),
	BackgroundColor3 = T.accent,
	BackgroundTransparency = 0.08,
	Text = "◢",
	TextColor3 = T.text,
	TextSize = 14,
	Font = Enum.Font.GothamBold,
	AutoButtonColor = false,
	ZIndex = 5,
})
corner(grip, 9)
grip.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		resizeStart = input.Position
		startSize = main.Size
		input.Changed:Connect(function() if input.UserInputState == Enum.UserInputState.End then resizing = false end end)
	end
end)
grip.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then resizeInput = input end
end)
UserInputService.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
	elseif resizing and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - resizeStart
		local viewport = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(1200, 800)
		local minWidth, maxWidth = math.min(680, math.max(320, viewport.X - 24)), math.min(1120, math.max(360, viewport.X - 20))
		local minHeight, maxHeight = math.min(440, math.max(280, viewport.Y - 48)), math.min(780, math.max(300, viewport.Y - 40))
		local width = math.clamp(startSize.X.Offset + delta.X, minWidth, maxWidth)
		local height = math.clamp(startSize.Y.Offset + delta.Y, minHeight, maxHeight)
		main.Size = UDim2.fromOffset(width, height)
	end
end)

-- Adapt the default bounds for smaller screens; the grip remains available for fine adjustments.
local camera = Workspace.CurrentCamera
if camera then
	local function adaptToViewport(viewport)
		local width = math.clamp(viewport.X - 24, 320, 920)
		local height = math.clamp(viewport.Y - 60, 300, 640)
		main.Size = UDim2.fromOffset(width, height)
		local compact = viewport.X < 620
		local navWidth = compact and 116 or 170
		nav.Size = UDim2.new(0, navWidth, 1, -12)
		pagesHolder.Position = UDim2.new(0, navWidth + 22, 0, 0)
		pagesHolder.Size = UDim2.new(1, -(navWidth + 34), 1, -12)
		title.Size = UDim2.new(0, compact and 170 or 280, 0, 28)
		subtitle.Size = UDim2.new(0, compact and 190 or 390, 0, 18)
	end
	adaptToViewport(camera.ViewportSize)
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		adaptToViewport(camera.ViewportSize)
	end)
end

main.Visible = true
